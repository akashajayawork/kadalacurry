{
  "name": "kadalacurry",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174",
    "dev:emulator": "vite --mode emulator",
    "emulators": "npx --yes firebase-tools@13 emulators:start --project demo-kadalacurry",
    "build": "tsc -b && vite build && vite build --mode demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "node scripts/test-rules.mjs",
    "emulators:stop": "node scripts/stop-emulators.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
