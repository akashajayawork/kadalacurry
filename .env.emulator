# Used by `npm run dev:emulator`: the app talks to the local Firebase emulators
# (`npm run emulators`) instead of the real project. No real data is touched.
# "demo-" project ids only ever run against emulators.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-kadalacurry.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-kadalacurry
VITE_FIREBASE_STORAGE_BUCKET=demo-kadalacurry.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
